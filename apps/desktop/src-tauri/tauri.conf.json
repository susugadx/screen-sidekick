{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Sidekick",
  "version": "0.0.0",
  "identifier": "dev.screen-sidekick.app",
  "build": {
    "beforeDevCommand": "trunk serve ../ui/index.html --port 1420 --open false",
    "beforeBuildCommand": "trunk build ../ui/index.html --release --dist ../ui/dist",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Screen Sidekick",
        "width": 760,
        "height": 520,
        "minWidth": 620,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
